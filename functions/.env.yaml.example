# Copy to functions/.env.yaml and fill in. That file is gitignored — it holds a
# refresh token, which is a real credential. Never commit it.
#
# Deploy with:  --env-vars-file=functions/.env.yaml

GOOGLE_CLIENT_ID: "PASTE-DESKTOP-CLIENT-ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET: "PASTE-DESKTOP-CLIENT-SECRET"
GOOGLE_REFRESH_TOKEN: "PASTE-REFRESH-TOKEN-FROM-tools/mint-refresh-token.js"
TIMEZONE: "Europe/London"
DRIVE_FILE_NAME: "cubcave-data.json"
