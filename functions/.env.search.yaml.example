# Config for the comic-search function only.
#
# Kept separate from .env.yaml on purpose: search has no business holding the
# Drive refresh token, and the daily job has no business holding the Comic Vine
# key. Each function gets only what it needs.
#
# Copy to functions/.env.search.yaml and fill in. That file is gitignored.
#
# Deploy with:  --env-vars-file=functions/.env.search.yaml

COMICVINE_API_KEY: "PASTE-YOUR-COMIC-VINE-API-KEY"

# The WEB OAuth client ID (the one in js/config.js) — not the desktop one.
# Callers must present a Google token issued to this client, which is what
# stops the endpoint being a free public comic API on your quota.
GOOGLE_WEB_CLIENT_ID: "1009364728296-1at2tingike66r7bvqqok6qul5tiv685.apps.googleusercontent.com"

ALLOWED_ORIGINS: "https://graciouscub.github.io,http://localhost:5173"
