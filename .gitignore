# Secrets — never commit these. Cloud Function keys and any local config with
# API keys or OAuth client secrets live outside the repo.
.env
.env.*
!.env.yaml.example
!.env.search.yaml.example
*.key
service-account*.json
secrets.json

# Deploy-time config for the Cloud Functions. .env.yaml holds the OAuth refresh
# token (ongoing access to the Drive app folder); .env.search.yaml holds the
# Comic Vine API key. Kept apart so each function gets only what it needs.
functions/.env.yaml
functions/.env.search.yaml

# Node (used by tools/ and, later, the Cloud Function)
node_modules/
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
